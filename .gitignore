# ============================================================
# KasToko — Git Ignore Rules (Tahap 4 Security Audit)
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output
/.next/
/out/
/build

# Testing & Coverage
/coverage
test-results/
playwright-report/
blob-report/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.eslintcache

# Environment Variables & Secrets (DILARANG KERAS DI-COMMIT)
.env
.env.*
!.env.example

# SSL Certificates & Private Keys
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# Debug Logs
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Vercel & Cloud Deployments
.vercel

# Local Database & Storage Dumps
data/
uploads/
backups/
*.sql.gz
*.sql.bak
*.dump

# AI agent context memory (berisi kredensial — jangan commit)
.agents/
