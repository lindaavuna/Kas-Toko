# ==============================================================================
# KasToko POS & Backoffice UMKM — Contoh Konfigurasi Environment (.env.example)
# Salin berkas ini ke `.env.local` lalu sesuaikan dengan nilai lingkungan Anda.
# CATATAN: JANGAN PERNAH MENG-COMMIT BERKAS .env ATAU .env.local KE REPOSITORY GIT!
# ==============================================================================

# --- Mode Aplikasi ('saas' atau 'self-hosted') ---
# 'self-hosted' : Menu sewa disembunyikan, kunci AI dikonfigurasi mandiri di pengaturan
# 'saas'        : Multi-tenant dengan status sewa bulanan dan konfigurasi AI terpusat
APP_MODE=self-hosted
NEXT_PUBLIC_APP_MODE=self-hosted

# --- Konfigurasi URL & Port Aplikasi ---
NEXT_PUBLIC_APP_URL=http://localhost:9991
PORT=9991

# --- PostgreSQL 16 Database ---
# Port standar container Docker KasToko adalah 5433 (agar tidak bentrok dengan Postgres default port 5432)
POSTGRES_USER=kastoko
POSTGRES_PASSWORD=ganti_dengan_password_aman_anda
POSTGRES_DB=kastoko
DATABASE_URL=postgresql://kastoko:ganti_dengan_password_aman_anda@localhost:5433/kastoko

# --- Keamanan Cookie Sesi (Enkripsi SHA-256 / HMAC) ---
# Wajib string acak rahasia minimal 32 karakter di lingkungan produksi
SESSION_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# --- Asisten AI Toko Hermes (Nous Research via OpenRouter / FreeLLM / Ollama Lokal) ---
# Untuk mode gratis tanpa biaya: gunakan FreeLLM atau OpenRouter model free
AI_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL_NAME=nousresearch/hermes-3-llama-3.1-8b:free
# Variabel alternatif yang didukung aplikasi:
HERMES_API_BASE_URL=https://openrouter.ai/api/v1
HERMES_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-8b:free

# --- Integrasi Pembayaran QRIS Dinamis (Duitku Gateway - Opsional) ---
# Dapatkan Merchant Code dan API Key dari dashboard Duitku (https://duitku.com)
DUITKU_MERCHANT_CODE=xxxx
DUITKU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DUITKU_API_URL=https://sandbox-duitku.com/webapi/api/merchant/createInvoice
DUITKU_TRANSACTION_STATUS_URL=https://sandbox-duitku.com/webapi/api/merchant/transactionStatus
DUITKU_CALLBACK_URL=https://tokoanda.com/api/payment/duitku/callback
DUITKU_RETURN_URL=https://tokoanda.com/kasir/riwayat

# --- Cloud SaaS Opsional (Bila Menggunakan Layanan Supabase Terkelola) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ganti_dengan_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=ganti_dengan_supabase_service_role_key

